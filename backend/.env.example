# Copy this file to backend/.env and fill in real values before running `docker compose up`.

# ─────────────────────────────────────────────────────────────
# SERVER SETUP
# NOTE: FRONTEND_URL is NOT read from here under Docker Compose — it's
# overridden by ${FRONTEND_URL} from the root .env (docker-compose.yml).
# Edit it there, not here, or the change will silently have no effect.
# This line only matters if running the backend standalone (no Docker).
# ─────────────────────────────────────────────────────────────
PORT=3000
FRONTEND_URL=http://localhost

# ─────────────────────────────────────────────────────────────
# GOOGLE OAUTH CREDENTIALS
# *** UPDATE GOOGLE_CALLBACK_URL FOR PRODUCTION DEPLOYMENT ***
# Must match EXACTLY what is registered in Google Cloud Console >
# Credentials > Authorized redirect URIs.
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

VITE_GOOGLE_MAPS_API_KEY=changeme

# ─────────────────────────────────────────────────────────────
# DATABASE
# Must match the values in the root .env (MYSQL_PASSWORD / DB_PASSWORD).
# DB_HOST is overridden to "db" by docker-compose.yml automatically.
# ─────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cspc_user
DB_PASSWORD=changeme
DB_NAME=cspc_boarding_db

# ─────────────────────────────────────────────────────────────
# SECURITY
# Must match the value in the root .env (JWT_SECRET).
# ─────────────────────────────────────────────────────────────
JWT_SECRET=changeme

# ─────────────────────────────────────────────────────────────
# PAYMONGO
# ─────────────────────────────────────────────────────────────
PAYMONGO_SECRET_KEY=changeme

# ─────────────────────────────────────────────────────────────
# CLOUDINARY (Image Storage — only used if STORAGE_PROVIDER=cloudinary)
# ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=changeme
CLOUDINARY_API_KEY=changeme
CLOUDINARY_API_SECRET=changeme
