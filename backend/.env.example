# =========================================================================
# CSPC BH FINDER - BACKEND ENVIRONMENT VARIABLES
# Docker server: copy to backend/.env and fill in the values marked CHANGE.
# Never commit backend/.env. Examples below are for https://bhfinder.cspc.edu.ph
# =========================================================================

# --- Site address -------------------------------------------------------
# Public address of the website (no trailing slash). Used for email links, Google sign-in
# redirects, payment return pages and the allowed-origin (CORS) check.
FRONTEND_URL=https://bhfinder.cspc.edu.ph

# --- Security -----------------------------------------------------------
# CHANGE: long random secret for login tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it later signs everyone out.
JWT_SECRET=

# --- Database -----------------------------------------------------------
# In Docker these are set by docker-compose.yml (host "db", user cspc_user, password from
# the root .env). Fill them only when running the backend without Docker.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cspc_user
DB_PASSWORD=
DB_NAME=cspc_boarding_db

# --- File storage -------------------------------------------------------
# In Docker this is forced to "local": uploads are saved in the media_uploads volume and
# served by the media_storage container. "cloudinary" is only for hosted setups (Render).
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google sign-in (Google Cloud Console > APIs & Services > Credentials) ----
# OAuth 2.0 Client ID (Web application). Add the callback below as an Authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://bhfinder.cspc.edu.ph/api/auth/google/callback

# --- Email (Brevo transactional API) -------------------------------------
# Verification links and notification emails. Sender must be verified in Brevo.
APPLICANT_EMAIL_ENABLED=true
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=CSPC BH Finder
NOTIFICATION_EMAIL_ENABLED=true

# --- Online payments (each owner connects their own PayMongo account) ----
# live = real money (requires HTTPS). Use test on test servers and laptops.
PAYMONGO_PAYMENT_MODE=live
PAYMONGO_DIRECT_ACCOUNTS_ENABLED=true
# Public HTTPS address PayMongo sends payment confirmations to (no path, no trailing slash).
PAYMONGO_WEBHOOK_BASE_URL=https://bhfinder.cspc.edu.ph
# CHANGE: 64 hex characters; encrypts owners' saved PayMongo keys. Keep a private backup:
# losing or changing it forces every owner to reconnect. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_CONNECTION_ENCRYPTION_KEY=
# Platform PayMongo key: only for checkouts started under the old single-account setup.
# Not needed on a new installation; leave empty.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# --- Reverse proxies -----------------------------------------------------
# Number of proxies in front of the backend. Docker's own nginx counts as 1. Use 2 when the server's
# HTTPS proxy / load balancer forwards to this Docker setup. Leave unset on Render.
TRUST_PROXY_HOPS=1

# --- Testing ------------------------------------------------------------
# Booking test calendar for local demos only. Keep false on the server.
ENABLE_BOOKING_TEST_CLOCK=false
