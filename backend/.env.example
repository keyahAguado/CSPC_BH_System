# =========================================================================
# CSPC BH FINDER - BACKEND ENVIRONMENT VARIABLES
# Docker server: copy to backend/.env and fill in the values marked CHANGE.
# Never commit backend/.env. Examples below are for https://bhfinder.cspc.edu.ph
# =========================================================================

# --- Site address -------------------------------------------------------
# Public address of the website (no trailing slash). Used for email links, Google sign-in
# redirects, payment return pages and the allowed-origin (CORS) check.
FRONTEND_URL=https://bhfinder.cspc.edu.ph

# Production runtime; blocks the local booking test clock even if its flag is enabled.
NODE_ENV=production

# --- Security -----------------------------------------------------------
# CHANGE: long random secret for login tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it later signs everyone out.
JWT_SECRET=

# Google reCAPTCHA v2 secret matching the frontend VITE_RECAPTCHA_SITE_KEY.
# Required for email/password login; keep this secret on the backend only.
# Add localhost and the public website hostname to the key's allowed domains in Google.
# FRONTEND_URL must match the website used to solve the challenge.
RECAPTCHA_SECRET_KEY=

# --- Database -----------------------------------------------------------
# In Docker these are set by docker-compose.yml (host "db", user cspc_user, password from
# the root .env). Fill them only when running the backend without Docker.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cspc_user
DB_PASSWORD=
DB_NAME=cspc_boarding_db

# --- File storage -------------------------------------------------------
# In Docker this is forced to "local": uploads are saved in the media_uploads volume and
# served by the media_storage container. "cloudinary" is only for hosted setups (Render).
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google sign-in (Google Cloud Console > APIs & Services > Credentials) ----
# OAuth 2.0 Client ID (Web application). Add the callback below as an Authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://bhfinder.cspc.edu.ph/api/auth/google/callback

# --- Email (Brevo transactional API) -------------------------------------
# Verification links and notification emails. Sender must be verified in Brevo.
APPLICANT_EMAIL_ENABLED=true
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=CSPC BH Finder
NOTIFICATION_EMAIL_ENABLED=true

# --- Online payments (each owner connects their own PayMongo account) ----
# live = real money (requires HTTPS). Use test on test servers and laptops.
PAYMONGO_PAYMENT_MODE=live
PAYMONGO_DIRECT_ACCOUNTS_ENABLED=true
# Public HTTPS address PayMongo sends payment confirmations to (no path, no trailing slash).
PAYMONGO_WEBHOOK_BASE_URL=https://bhfinder.cspc.edu.ph
# CHANGE: 64 hex characters; encrypts owners' saved PayMongo keys. Keep a private backup:
# losing or changing it forces every owner to reconnect. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_CONNECTION_ENCRYPTION_KEY=
# Platform PayMongo key: only for checkouts started under the old single-account setup.
# Not needed on a new installation; leave empty.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# --- Reverse proxies -----------------------------------------------------
# Count trusted proxy hops from the backend outward, not counting the browser or backend.
# A reverse proxy receives a browser request and forwards it to the application.
#
# 1: Browser -> Docker Nginx -> backend
#    Docker Nginx is the only proxy between the browser and the backend.
#
# 2: Browser -> HTTPS reverse proxy/load balancer -> Docker Nginx -> backend
#    Use this when another proxy terminates HTTPS and forwards requests into Docker.
#
# 3: Browser -> trusted edge/CDN proxy -> HTTPS reverse proxy -> Docker Nginx -> backend
#    Use only if all three proxies are actually present and configured as trusted.
#
# A firewall, router, port-forwarding rule or NAT does not count unless it acts as
# an HTTP reverse proxy. Count each proxy once; HTTPS alone does not add a hop.
# The application accepts 1-5; unset/invalid values fall back to 1. Zero is not supported.
#
# Why this matters: Express uses the trusted chain to determine the visitor IP and
# whether the original request used HTTPS. These affect rate limits and secure flows.
# Too few hops can identify a proxy as the visitor; too many can trust spoofed headers.
# All access paths must have the expected trusted chain. Restrict direct backend access;
# the supplied frontend already reaches backend:3000 through the Docker network.
#
# The public-facing proxy must replace untrusted X-Forwarded-* headers and pass the
# actual client address/scheme. Docker Nginx forwards the address chain and HTTPS scheme.
# Before launch, confirm the chain with the server operator and verify real client IPs,
# HTTPS behavior and rate limits. Do not raise this number just to suppress an error.
#
# After changing this value, recreate the backend so it reads the updated environment:
#   docker compose up -d --force-recreate backend
TRUST_PROXY_HOPS=1

# --- Testing ------------------------------------------------------------
# Booking test calendar for local demos only. Keep false on the server.
ENABLE_BOOKING_TEST_CLOCK=false
