# =========================================================================
# CSPC BOARDING HOUSE MANAGEMENT SYSTEM — BACKEND ENVIRONMENT VARIABLES
# =========================================================================

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=cspc_bh_db
DB_PORT=3306

# Server Configuration
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_here

# File storage: "local" (saved under UPLOADS_DIR, default ./uploads) or "cloudinary"
STORAGE_PROVIDER=local
UPLOADS_DIR=

# Google sign-in (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# PayMongo online payments (Dashboard -> Developers). Use test keys (sk_test_...) outside production.
PAYMONGO_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYMONGO_WEBHOOK_SECRET=whsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Cloudinary Storage Configuration (only when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# =========================================================================
# BREVO TRANSACTIONAL EMAIL HTTPS API CONFIGURATION (Render / Cloud Deployment)
# =========================================================================
# Obtain from Brevo Dashboard -> SMTP & API -> API Keys: https://app.brevo.com/settings/keys/api
APPLICANT_EMAIL_ENABLED=false
# Required base URL for verification links (e.g. http://localhost for Docker frontend).
FRONTEND_URL=http://localhost
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified Sender Email Address in Brevo (Must match Senders & IP setting in Brevo)
EMAIL_FROM_ADDRESS=your-verified-email@gmail.com

# Display Sender Name shown in email client header
EMAIL_FROM_NAME=CSPC Boarding House System

# Independent opt-in switch for notification emails (a fresh install from init.sql already has its tables).
NOTIFICATION_EMAIL_ENABLED=false

# Booking test calendar: true turns on /owner/testing-clock for local testing (ignored in production and with live PayMongo keys).
ENABLE_BOOKING_TEST_CLOCK=false
