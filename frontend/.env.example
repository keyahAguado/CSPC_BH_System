# =========================================================================
# FRONTEND (Vue / Vite) - read at BUILD time
# Docker server: copy to frontend/.env.production.local, then rebuild:
#   docker compose up -d --build frontend
# Values are built into the website and visible to browsers: never put secrets here.
# =========================================================================

# Leave EMPTY on the Docker server: the site calls /api on its own address (nginx forwards it).
VITE_API_URL=

# Google Maps JavaScript API key (browser key). Restrict it in Google Cloud Console to
# HTTP referrers: https://bhfinder.cspc.edu.ph/*
VITE_GOOGLE_MAPS_API_KEY=

# Optional: Google Maps Map ID for styled maps. Leave empty to use the default.
VITE_GOOGLE_MAPS_MAP_ID=

# Google reCAPTCHA v2 ("I'm not a robot") site key for the email/password login.
# Optional: when empty, the checkbox is hidden and login works without it.
# Register the site domain (e.g. bhfinder.cspc.edu.ph) in the reCAPTCHA admin console.
VITE_RECAPTCHA_SITE_KEY=
