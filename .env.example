# =========================================================================
# DOCKER COMPOSE (root) - database and bundled S3 storage settings
# Copy to .env (same folder as docker-compose.yml) before `docker compose up -d --build`.
# All settings belong in root .env; frontend VITE_* values are public.
# =========================================================================

# MySQL root password (used only inside the database container).
MYSQL_ROOT_PASSWORD=change-to-a-long-random-password

# Password of the application database user (cspc_user).
# MYSQL_PASSWORD and DB_PASSWORD must be the SAME value.
MYSQL_PASSWORD=change-to-another-long-random-password
DB_PASSWORD=change-to-another-long-random-password

# Pigsty Silo storage (different admin and application credentials).
SILO_ROOT_USER=cspc-storage-admin
SILO_ROOT_PASSWORD=replace-with-a-long-random-admin-secret
S3_BUCKET=cspc-bh-media
S3_ACCESS_KEY_ID=cspc-media-app
S3_SECRET_ACCESS_KEY=replace-with-a-different-long-random-app-secret

# Backend settings
FRONTEND_URL="https://bhfinder.cspc.edu.ph"
NODE_ENV="production"
JWT_SECRET=""
RECAPTCHA_SECRET_KEY=""
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="cspc_user"
DB_NAME="cspc_boarding_db"
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="true"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="https://bhfinder.cspc.edu.ph/api/auth/google/callback"
APPLICANT_EMAIL_ENABLED="true"
BREVO_API_KEY=""
EMAIL_FROM_ADDRESS=""
EMAIL_FROM_NAME="CSPC BH Finder"
NOTIFICATION_EMAIL_ENABLED="true"
PAYMONGO_PAYMENT_MODE="live"
PAYMONGO_DIRECT_ACCOUNTS_ENABLED="true"
PAYMONGO_WEBHOOK_BASE_URL="https://bhfinder.cspc.edu.ph"
PAYMENT_CONNECTION_ENCRYPTION_KEY=""
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
TRUST_PROXY_HOPS="1"
ENABLE_BOOKING_TEST_CLOCK="false"

# Public frontend settings (visible to browsers)
VITE_API_URL=
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
VITE_RECAPTCHA_SITE_KEY=
