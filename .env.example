# =========================================================================
# DOCKER COMPOSE (root) - database passwords only
# Copy to .env (same folder as docker-compose.yml) before `docker compose up -d --build`.
# Backend settings go in backend/.env; frontend settings in frontend/.env.production.local.
# =========================================================================

# MySQL root password (used only inside the database container).
MYSQL_ROOT_PASSWORD=change-to-a-long-random-password

# Password of the application database user (cspc_user).
# MYSQL_PASSWORD and DB_PASSWORD must be the SAME value.
MYSQL_PASSWORD=change-to-another-long-random-password
DB_PASSWORD=change-to-another-long-random-password
