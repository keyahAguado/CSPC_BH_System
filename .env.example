# Copy this file to .env and fill in real values before running `docker compose up`.
MYSQL_ROOT_PASSWORD=changeme
MYSQL_PASSWORD=changeme
DB_PASSWORD=changeme
JWT_SECRET=changeme

# Public origin the backend redirects Google OAuth logins back to.
# For local Docker: http://localhost
# For production:
FRONTEND_URL=http://localhost

# Google Maps browser key, baked into the frontend at build time.
# Restrict it by HTTP referrer (e.g. http://localhost/*) in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=
